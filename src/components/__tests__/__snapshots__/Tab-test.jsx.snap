  aria-disabled="false"
  aria-selected="false"
  class="foobar"
  data-rttab="0"
  role="tab"
/>
`;

exports[`<Tab /> > should allow to be wrapped in higher-order-component 1`] = `
<li
  aria-disabled="false"
  aria-selected="false"
  class="react-tabs__tab"
  data-rttab="0"
  role="tab"
/>
`;

exports[`<Tab /> > should have sane defaults 1`] = `
<li
  aria-disabled="false"
  aria-selected="false"
  class="react-tabs__tab"
  data-rttab="0"
  role="tab"
/>
`;

exports[`<Tab /> > should not allow overriding all default properties 1`] = `
<li
  aria-disabled="false"
  aria-selected="false"
  class="react-tabs__tab"
  data-rttab="0"
  role="tab"
/>
`;

exports[`<Tab /> > should pass through custom properties 1`] = `
<li
  aria-disabled="false"
  aria-selected="false"
  class="react-tabs__tab"
  data-rttab="0"
  data-tooltip="Tooltip contents"
  role="tab"
/>
`;

exports[`<Tab /> > should support being disabled 1`] = `
<li
  aria-disabled="true"
  aria-selected="false"
  class="react-tabs__tab react-tabs__tab--disabled"
  data-rttab="0"
  role="tab"
/>
`;

exports[`<Tab /> > should support being disabled with custom class name 1`] = `
<li
  aria-disabled="true"
  aria-selected="false"
  class="react-tabs__tab coolDisabled"
  data-rttab="0"
  role="tab"
/>
`;

exports[`<Tab /> > should support being selected 1`] = `
<li
  aria-controls="panelgroup-0"
  aria-disabled="false"
  aria-selected="true"
  class="react-tabs__tab react-tabs__tab--selected"
  data-rttab="0"
  id="tabgroup-0"
  role="tab"
  tabindex="0"
>
  Hello
</li>
`;

exports[`<Tab /> > should support being selected with custom class 1`] = `
<li
  aria-controls="panelgroup-0"
  aria-disabled="false"
  aria-selected="true"
  class="react-tabs__tab cool"
  data-rttab="0"
