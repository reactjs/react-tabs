{
  "name": "react-tabs",
  "version": "6.1.3",
  "description": "An accessible and easy tab component for ReactJS",
  "main": "lib/index.js",
  "module": "esm/index.js",
  "typings": "index.d.ts",
  "scripts": {
    "clean:commonjs": "rm -rf lib",
    "clean:esm": "rm -rf esm",
    "build:commonjs": "cross-env BABEL_OUTPUT=commonjs babel src/ --out-dir lib/ --ignore **/__tests__,**/__mocks__",
    "build:esm": "babel src/ --out-dir esm/ --ignore **/__tests__,**/__mocks__",
    "build": "pnpm run --sequential '/clean:.*|build:.*/'",
    "format": "eslint src --fix --report-unused-disable-directives",
    "lint": "eslint src --report-unused-disable-directives",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "start": "pnpm --filter react-tabs-examples start"
  },
  "packageManager": "pnpm@12.23.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/reactjs/react-tabs.git"
  },
  "author": "Matt Zabriskie",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/reactjs/react-tabs/issues"
  },
  "files": [
    "esm",
    "lib",
    "style",
    "index.d.ts"
  ],
  "homepage": "https://github.com/reactjs/react-tabs",
  "keywords": [
    "react",
    "tabs",
    "a11y",
    "react-component"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.13",
    "@babel/preset-env": "7.29.14",
    "@babel/preset-react": "7.29.7",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint-react/eslint-plugin": "5.30.6",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@vitest/coverage-v8": "5.1.1",
    "babel-plugin-transform-react-remove-prop-types": "0.4.24",
    "cross-env": "10.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-prettier": "5.5.7",
    "happy-dom": "21.0.4",
    "hoist-non-react-statics": "3.3.2",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "prop-types": "^15.5.0"
  }
}
